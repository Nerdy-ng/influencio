{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Referrer-Policy", "value": "no-referrer" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin/:path*",
      "has": [{ "type": "host", "value": "www.brandior.africa" }],
      "destination": "https://app.brandior.africa/admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
